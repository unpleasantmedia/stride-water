// A sea ring's vertex: moved by the sea's Gerstner waves (each pulling it round in a circle, so crests sharpen and
// troughs flatten), and turned to their slope. Towards its ring's outer edge, a vertex on an odd line morphs onto the
// even one before it, as the terrain's do, so a ring meets the next one's coarser grid with no cracks. Waves too short
// for a ring's cells fade out there, rather than flicker.
namespace Stride.Water
{
    shader SeaWaves : IMaterialSurface, SeaMaps, PositionStream4, NormalStream, Transformation
    {
        override void Compute()
        {
            float4 world = mul(streams.Position, World);
            float scale = World[0][0];
            float2 cell = round(world.xz / scale);
            float away = length(world.xz - SeaCamera.xz) / scale;
            float morph = smoothstep(SeaCells * 0.7625f, SeaCells * 0.9625f, away);
            float2 odd = cell - 2.0f * floor(cell * 0.5f);
            world.xz -= odd * scale * morph;
            // The cells it is drawn with here (twice as wide where it has morphed to the next ring's).
            float drawn = scale * (1.0f + morph);

            float2 at = world.xz;
            float3 offset = 0;
            float3 normal = float3(0, 1, 0);
            // Its wind waves die away through its surf, gone at the shore, where its breakers take over.
            float4 shore = ShoreAt(at);
            float calm = 1.0f - smoothstep(0.0f, 0.9f, SurfOf(shore));
            [unroll]
            for (int i = 0; i < 12; i++)
            {
                float2 direction = Waves[i].xy;
                float k = Waves[i].z;
                float full = Waves[i].w;
                // Its steepness spread over the waves, so their crests together never loop over.
                float q = WaveMotion[i].y / max(k * full * 12.0f, 1e-4f);
                // Faded out where it is under four of the cells it is drawn with.
                float wavelength = 6.2831853f / max(k, 1e-4f);
                float height = full * saturate(wavelength / (4.0f * drawn) - 1.0f) * calm;
                float phase = k * dot(direction, at) - WaveMotion[i].x * Time + WaveMotion[i].z;
                float c = cos(phase), s = sin(phase);
                offset.xz += q * height * direction * c;
                offset.y += height * s;
                normal.xz -= direction * k * height * c;
                normal.y -= q * k * height * s;
            }
            // Its breaker: a Gerstner wave running towards the shore (down its distance to it).
            float3 breaker = BreakerAt(shore);
            float breakerLength = 6.2831853f / max(Breaker.x, 1e-4f);
            breaker.x *= saturate(breakerLength / (4.0f * drawn) - 1.0f);
            float2 towards = shore.zw;
            float bc = cos(breaker.z), bs = sin(breaker.z);
            offset.xz += breaker.y * breaker.x * towards * bc;
            offset.y += breaker.x * bs;
            normal.xz -= towards * Breaker.x * breaker.x * bc;
            normal.y -= breaker.y * Breaker.x * breaker.x * bs;

            // In shallow water its troughs go no deeper than half the water, so its surface never dips under the
            // ground at the shore (its crests still rise).
            offset.y = max(offset.y, -0.5f * max(shore.y, 0.0f));

            world.xyz += offset;

            streams.Position = mul(world, WorldInverse);
            // Back into the ring's own space, which the world turns it from (scaled along x and z): by the world's transpose.
            streams.meshNormal = normalize(mul(normalize(normal), transpose((float3x3)World)));
        }
    };
}
